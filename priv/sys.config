[
  {kernel, [
    % Configure Erlang logger handlers
    % Default: both console and file output
    {logger, [
      {handlers, [
        % Console handler - always enabled
        {default, logger_std_h, #{
          level => info,
          formatter => {logger_formatter, #{
            template => [time, " [", level, "] ", pid, " ", mfa, ":", line, " ", msg, "\n"]
          }}
        }},
        % File handler - logs to vault.log
        {file, logger_disk_log_h, #{
          config => #{
            file => "vault.log",
            type => wrap,
            max_no_files => 10,
            max_no_bytes => 10485760  % 10MB per file
          },
          level => debug,
          formatter => {logger_formatter, #{
            template => [time, " [", level, "] ", pid, " ", mfa, ":", line, " ", msg, "\n"]
          }}
        }}
      ]}
    ]}
  ]},
  {vault, [
    %% CouchDB connection — overridable via env vars:
    %%   VAULT_DB_URL     (default: "http://localhost:5984")
    %%   VAULT_DB_NAME    (default: "mozaik_vault")
    %%   VAULT_DB_TIMEOUT (default: 5000 ms)
    {couchdb_url, "http://localhost:5984"},
    {couchdb_db_name, "mozaik_vault"},
    {couchdb_timeout, 5000}
  ]}
].
