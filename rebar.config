{erl_opts, [
  debug_info,
  warnings_as_errors,
  warn_deprecated_function,
  warn_missing_spec
]}.

{project_plugins, [erlfmt]}.

{erlfmt, [
  write,
  {print_width, 100},
  {files, ["src/**/*.{erl,hrl,app.src}", "test/**/*.erl"]}
]}.

{ct_dirs, ["test"]}.

{ct_opts, [
  {sys_config, ["priv/sys.config"]},
  {logdir, "_build/test/logs"},
  {ct_hooks, [cth_surefire]}
]}.

%% Ensure vault app is built and available for CT
{profiles, [
  {test, [
    {deps, [
      {vault, {path, "."}}
    ]}
  ]}
]}.

